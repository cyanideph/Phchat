<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="PhchatLaunchTheme" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowBackground">@color/phchat_graphite</item>
        <item name="android:colorAccent">@color/phchat_lime</item>
        <item name="android:statusBarColor">@color/phchat_graphite</item>
        <item name="android:navigationBarColor">@color/phchat_graphite</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>
</resources>
